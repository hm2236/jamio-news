{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JAMIO NEWS autonomous shadow evidence v1",
  "description": "Detached shadow evidence, never a publication authorization. All refs are local. Runtime adds source/claim/date/digest checks. Structural checks do not prove semantic truth or completeness.",
  "type": "object", "additionalProperties": false,
  "required": ["version", "context", "reportDigest", "packageDigest", "stories"],
  "properties": {
    "version": {"const": 1},
    "context": {"$ref": "#/$defs/context"},
    "reportDigest": {"$ref": "#/$defs/hash"},
    "packageDigest": {"$ref": "#/$defs/hash"},
    "stories": {"type":"array", "minItems":5, "maxItems":10, "items":{"$ref":"#/$defs/story"}}
  },
  "$defs": {
    "text": {"type":"string", "minLength":1, "pattern":"\\S"},
    "reason": {"type":"string", "minLength":30, "pattern":"\\S"},
    "hash": {"type":"string", "pattern":"^[a-f0-9]{64}$"},
    "context": {
      "type":"object", "additionalProperties":false,
      "required":["runId","attempt","startedAt","date","slug","baseSha","windowStart"],
      "properties": {
        "runId":{"type":"string","pattern":"^[1-9][0-9]*$"},
        "attempt":{"type":"integer","minimum":1},
        "startedAt":{"type":"string","format":"jst-date-time"},
        "date":{"type":"string","format":"date"},
        "slug":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}-morning$"},
        "baseSha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
        "windowStart":{"type":"string","format":"jst-date-time"}
      }
    },
    "citation": {
      "type":"object","additionalProperties":false,"required":["url","excerpt"],
      "properties":{"url":{"type":"string","format":"source-url"},"excerpt":{"type":"string","minLength":20,"pattern":"\\S"}}
    },
    "claim": {
      "type":"object","additionalProperties":false,"required":["kind","text","citations"],
      "properties": {
        "kind":{"enum":["fact","inference","rumor"]},
        "text":{"type":"string","minLength":20,"pattern":"\\S"},
        "citations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/citation"}}
      }
    },
    "story": {
      "type":"object","additionalProperties":false,
      "required":["slug","eventUrl","eventAt","eventDateText","importance","impact","limitations","claims"],
      "properties": {
        "slug":{"$ref":"#/$defs/text"},
        "eventUrl":{"type":"string","format":"source-url"},
        "eventAt":{"type":"string","format":"jst-date-time"},
        "eventDateText":{"$ref":"#/$defs/text"},
        "importance":{"$ref":"#/$defs/reason"},
        "impact":{"$ref":"#/$defs/reason"},
        "limitations":{"$ref":"#/$defs/reason"},
        "claims":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/claim"}}
      }
    }
  }
}
