{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hm2236.github.io/jamio-news/contracts/series.schema.json",
  "title": "JAMIO reviewed news series v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "canonicalTopic",
    "entities",
    "status",
    "coverage",
    "revision",
    "updatedAt",
    "changeNote",
    "members"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "canonicalTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "scope"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "key",
          "label"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "organization",
              "product",
              "campaign",
              "incident",
              "legislation",
              "project"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed",
        "discontinued"
      ]
    },
    "expectedCount": {
      "type": "integer",
      "minimum": 1
    },
    "startedAt": {
      "type": "string",
      "format": "jst-date-time"
    },
    "expectedEndAt": {
      "type": "string",
      "format": "jst-date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "jst-date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "note"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "complete-from-start",
            "partial"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "parentSeriesId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "jst-date-time"
    },
    "changeNote": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "article",
          "sequence",
          "relation",
          "updateType",
          "eventKey"
        ],
        "properties": {
          "article": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "start",
              "update",
              "correction"
            ]
          },
          "updateType": {
            "type": "string",
            "enum": [
              "announcement",
              "rollout",
              "release",
              "review",
              "outage",
              "recovery",
              "postmortem",
              "deliberation",
              "enactment",
              "effective",
              "other"
            ]
          },
          "eventKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "milestone": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "delta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "correctsArticle": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  },
  "x-validation": [
    "filename=id.json; unique ids and entity type/key",
    "completed/discontinued require endedAt; active/paused forbid it; start<=end",
    "published news belonging to exactly one daily edition and its date/variant",
    "one primary series per article; members sorted as sequence 1..N",
    "only first=start without delta; later=update/correction with <=160 code point delta",
    "unique eventKey; milestone.ordinal<=expectedCount",
    "correction refers to earlier same-series article; others forbid correctsArticle",
    "article and edition published times nondecreasing; equal times allowed",
    "parent exists; no self reference or cycle",
    "ordinary append only active unchanged definition/prefix; no milestone reversal",
    "maintenance needs next revision/later updatedAt/new changeNote; human PR approval"
  ]
}
